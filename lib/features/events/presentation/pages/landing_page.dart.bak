  Widget _buildOrganizerCardAnimated(
    String name,
    String role,
    String achievement,
    IconData icon,
    int delay,
  ) {
    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0.0, end: 1.0),
      duration: Duration(milliseconds: 800 + delay),
      curve: Curves.easeOutBack,
      builder: (context, value, child) {
        return Transform.scale(
          scale: 0.8 + (0.2 * value),
          child: Opacity(
            opacity: value,
            child: _buildOrganizerCard(name, role, achievement, icon),
          ),
        );
      }   Text(
            'Expertos apasionados en crear experiencias únicas',
            textAlign: TextAlign.center,
            style: TextStyle(
              color: Colors.white.withOpacity(0.8),
              fontSize: 18,
            ),
          ),
          const SizedBox(height: 48),
          Wrap(
            spacing: 32,
            runSpacing: 32,
            alignment: WrapAlignment.center,
            children: [
              _buildOrganizerCard(
                'María González',
                'Especialista en Eventos Corporativos',
                '150+ eventos organizados',
                Icons.business_center,
              ),
              _buildOrganizerCard(
                'Carlos Ramírez',
                'Experto en Eventos Sociales',
                '200+ celebraciones',
                Icons.celebration,
              ),
              _buildOrganizerCard(
                'Ana Martínez',
                'Coordinadora de Conferencias',
                '80+ conferencias tech',
                Icons.computer,
              ),
            ],
          ),
        ],
      ),
    );
  }

