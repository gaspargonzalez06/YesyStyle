import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';
import '../../../../core/constants/app_colors.dart';
import '../../../../core/constants/user_roles.dart';
import '../../../../shared/animations/particle_background.dart';

class LandingPage extends StatefulWidget {
  const LandingPage({Key? key}) : super(key: key);

  @override
  State<LandingPage> createState() => _LandingPageState();
}

class _LandingPageState extends State<LandingPage>
    with SingleTickerProviderStateMixin {
  late AnimationController _fadeController;
  late Animation<double> _fadeAnimation;
  late Animation<Offset> _slideAnimation;
  final ScrollController _scrollController = ScrollController();
  
  bool _showMission = false;
  bool _showOrganizers = false;
  bool _showHowItWorks = false;
  bool _showCTA = false;

  @override
  void initState() {
    super.initState();
    _fadeController = AnimationController(
      duration: const Duration(milliseconds: 1500),
      vsync: this,
    );

    _fadeAnimation = Tween<double>(begin: 0.0, end: 1.0).animate(
      CurvedAnimation(parent: _fadeController, curve: Curves.easeIn),
    );

    _slideAnimation = Tween<Offset>(
      begin: const Offset(0, 0.3),
      end: Offset.zero,
    ).animate(
      CurvedAnimation(parent: _fadeController, curve: Curves.easeOut),
    );

    _fadeController.forward();
    
    // Setup scroll listener for section animations
    _scrollController.addListener(_onScroll);
    
    // Auto-scroll hint after initial load
    Future.delayed(const Duration(seconds: 3), () {
      if (mounted && _scrollController.hasClients) {
        _scrollController.animateTo(
          100,
          duration: const Duration(milliseconds: 800),
          curve: Curves.easeInOut,
        );
      }
    });
  }

  void _onScroll() {
    final scrollPosition = _scrollController.position.pixels;
    final maxScroll = _scrollController.position.maxScrollExtent;
    
    if (scrollPosition > 400 && !_showMission) {
      setState(() => _showMission = true);
    }
    if (scrollPosition > 800 && !_showOrganizers) {
      setState(() => _showOrganizers = true);
    }
    if (scrollPosition > 1400 && !_showHowItWorks) {
      setState(() => _showHowItWorks = true);
    }
    if (scrollPosition > maxScroll * 0.7 && !_showCTA) {
      setState(() => _showCTA = true);
    }
  }

  @override
  void dispose() {
    _fadeController.dispose();
    _scrollController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final size = MediaQuery.of(context).size;

    return Scaffold(
      body: Stack(
        children: [
          // Gradient Background
          Container(
            decoration: const BoxDecoration(
              gradient: LinearGradient(
                begin: Alignment.topLeft,
                end: Alignment.bottomRight,
                colors: [
                  AppColors.primaryDark,
                  AppColors.primaryPurple,
                  Color(0xFF9C27B0),
                ],
              ),
            ),
          ),

          // Particle Background
          const Positioned.fill(
            child: ParticleBackground(
              particleCount: 80,
              interactive: true,
            ),
          ),

          // Main Content
          SafeArea(
            child: SingleChildScrollView(
              controller: _scrollController,
              child: Container(
                constraints: BoxConstraints(minHeight: size.height - 48),
                child: Column(
                  children: [
                    // Header
                    _buildHeader(),

                    // Hero Section
                    Padding(
                      padding: const EdgeInsets.symmetric(vertical: 40),
                      child: _buildHeroSection(),
                    ),

                    // Scroll Indicator
                    _buildScrollIndicator(),

                    const SizedBox(height: 60),

                    // Features Section
                    _buildFeaturesSection(),

                    const SizedBox(height: 80),

                    // Mission Section
                    _buildAnimatedSection(
                      _buildMissionSection(),
                      _showMission,
                    ),

                    const SizedBox(height: 80),

                    // About Organizers Section
                    _buildAnimatedSection(
                      _buildOrganizersSection(),
                      _showOrganizers,
                    ),

                    const SizedBox(height: 80),

                    // How it Works Section
                    _buildAnimatedSection(
                      _buildHowItWorksSection(),
                      _showHowItWorks,
                    ),

                    const SizedBox(height: 80),

                    // CTA Section
                    _buildAnimatedSection(
                      _buildCTASection(),
                      _showCTA,
                    ),

                    const SizedBox(height: 40),
                  ],
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

