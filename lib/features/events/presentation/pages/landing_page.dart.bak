                  ),
                ),
                const SizedBox(height: 16),
                Container(
                  width: 80,
                  height: 4,
                  decoration: BoxDecoration(
                    gradient: LinearGradient(
                      colors: [
                        Colors.transparent,
                        Colors.white,
                        Colors.transparent,
                      ],
                    ),
                    borderRadius: BorderRadius.circular(2)ar(16),
            ),
            child: Icon(
              icon,
              size: 32,
              color: AppColors.primaryPurple,
            ),
          ),
          const SizedBox(height: 20),
          Text(
            title,
